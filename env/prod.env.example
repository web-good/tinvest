APP_PORT=8081
SWAGGER_PORT=8086
APP_ENV=prod
APP_NAME=t-invest
PORTFOLIO_YTD_START_VALUE=

# Telegram forum supergroup (ID вида -100XXXXXXXXXX) и ID тем (message_thread_id)
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_TOPIC_GOLDEN_X=
TELEGRAM_TOPIC_REVERSION=
TELEGRAM_TOPIC_NEWS=
TELEGRAM_TOPIC_RSI_PULLBACK=
TELEGRAM_TOPIC_RSI_ZONE=
TELEGRAM_TOPIC_GAP_FADE=
# NEWS_FEED_URL можно не задавать: дефолт — https://smart-lab.ru/news/rss/
# NEWS_FEED_URL=

# Reversion live runner
# Secret — inject at runtime, do NOT commit the value
REVERSION_TOKEN=
REVERSION_ACCOUNT_ID=
REVERSION_TICKERS=UGLD,EUTR,NVTK
REVERSION_BUY_PCT=10
REVERSION_TRADE_ENABLED=false
REVERSION_NOTIFY_ENABLED=true

# RSI Pullback live runner (docs/rsi_pullback/live.md) — отдельный счёт и токен.
# Secret — inject at runtime, do NOT commit the value
RSI_PULLBACK_TOKEN=
# Пустой ACCOUNT_ID = воркер не поднимается; приложение и воркеры reversion работают.
RSI_PULLBACK_ACCOUNT_ID=
RSI_PULLBACK_TICKERS=UGLD,T,GAZP,DOMRF,FESH,WUSH,LENT,RENI,NVTK,LSNGP,IVAT,SVAV,SIBN,ELFV,DIAS,BSPB,YDEX,BANEP,ASTR,SNGSP,NKHP,SOFL,TGKA,VSMO,SPBE,MVID,CNRU,AQUA,MAGN,IRKT,X5,SFIN,SVCB,RAGR,MDMG
RSI_PULLBACK_BUY_PCT=5
RSI_PULLBACK_TRADE_ENABLED=false
RSI_PULLBACK_NOTIFY_ENABLED=true
RSI_PULLBACK_SCHEDULE=1,31 6-23 * * *

# RSI Zone на счёте rsi_pullback (docs/rsi_zone/live.md): счёт, токен и расписание общие.
# Выкат — сначала бумажный режим при боевом rsi_pullback: бумажные входы zone приходят
# только уведомлениями и тикер не занимают.
RSI_ZONE_TICKERS=AFKS,BAZA,DIAS,IVAT
RSI_ZONE_BUY_PCT=5
RSI_ZONE_TRADE_ENABLED=false
RSI_ZONE_NOTIFY_ENABLED=true

# gap_fade на счёте rsi_pullback (docs/gap_fade/live.md): счёт, токен и расписание общие.
# Вселенная — из cmd/gapscreen, проверена cmd/gapwf. Выкат — бумажный режим при боевом
# rsi_pullback: входы приходят только уведомлениями и тикер не занимают.
GAP_FADE_TICKERS=
GAP_FADE_BUY_PCT=5
GAP_FADE_TRADE_ENABLED=false
GAP_FADE_NOTIFY_ENABLED=true
