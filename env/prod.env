APP_PORT=8081
SWAGGER_PORT=8086
APP_ENV=prod
APP_NAME=t-invest
PROFILES='[{"TBank":"Alice","ChatId":30},{"TBank":"Bob","ChatId":40}]'
PORTFOLIO_YTD_START_VALUE=463402

# Reversion live runner
REVERSION_ACCOUNT_ID=2021520905
REVERSION_TICKERS=UGLD,EUTR,NVTK
REVERSION_BUY_PCT=10
REVERSION_TRADE_ENABLED=false
REVERSION_NOTIFY_ENABLED=true

# RSI Pullback live runner (docs/rsi_pullback/live.md).
# Пока RSI_PULLBACK_ACCOUNT_ID пуст, воркер не поднимается — остальное приложение
# (Golden X, новости, оба воркера reversion) работает как обычно. Заполнять после того,
# как заведён отдельный счёт; RSI_PULLBACK_TOKEN приходит из секрета CI, не отсюда.
RSI_PULLBACK_ACCOUNT_ID=2026317489
RSI_PULLBACK_TICKERS=UGLD,T,GAZP,DOMRF,FESH,WUSH,LENT,RENI,NVTK,LSNGP,IVAT,SVAV,SIBN,ELFV,DIAS,BSPB,YDEX,BANEP,ASTR,SNGSP,NKHP,SOFL,TGKA,VSMO,SPBE,MVID,CNRU,AQUA,MAGN,IRKT,X5,SFIN,SVCB,RAGR,MDMG
RSI_PULLBACK_BUY_PCT=20
RSI_PULLBACK_TRADE_ENABLED=true
RSI_PULLBACK_NOTIFY_ENABLED=true
RSI_PULLBACK_SCHEDULE=1,31 6-23 * * *

# RSI Zone на счёте rsi_pullback (docs/rsi_zone/live.md): счёт, токен и расписание общие.
# Боевой режим с 2026-10-05: pullparity 0 расхождений (AFKS, BAZA, DIAS, 24 мес).
# Доля 5% — та, на которой мерилась совместная работа с rsi_pullback (50%).
RSI_ZONE_TICKERS=AFKS,BAZA,DIAS,IVAT,UPRO,MTSS,AFLT,MSNG,BANE,SVAV,TRNFP,SMLT,TATNP,RENI,FIXR,MOEX,TRMK,PHOR,HEAD,VTBR
RSI_ZONE_BUY_PCT=20
RSI_ZONE_TRADE_ENABLED=false
RSI_ZONE_NOTIFY_ENABLED=true

# Буст доли у тикера, отставшего от IMOEX (docs/rsi_pullback/live.md). Выключено.
LAG_BOOST_ENABLED=false
LAG_BOOST_MULT=2
LAG_BOOST_PCT=5
LAG_BOOST_DAYS=5

# gap_fade на счёте rsi_pullback (docs/gap_fade/live.md): счёт, токен и расписание общие.
# Вселенная — из cmd/gapscreen, проверена cmd/gapwf. Боевой режим с 2026-10-05
# после бумажного периода; pullparity 46/46 без расхождений.
GAP_FADE_TICKERS=SBER,T,GAZP,VTBR,LKOH,ROSN,PLZL,NVTK,SMLT,GMKN,YDEX,RUAL,OZON,X5,AFLT,AFKS,MAGN,TATN,MGNT,VKCO,WUSH,NLMK,MTLR,CHMF,MOEX,ALRS,SNGSP,RNFT,SVCB,SFIN,UGLD,SNGS,TRNFP,IRAO,DOMRF,MTSS,SBERP,PHOR,IVAT,POSI,SIBN,ASTR,RAGR,SELG,TATNP
GAP_FADE_BUY_PCT=20
GAP_FADE_TRADE_ENABLED=true
GAP_FADE_NOTIFY_ENABLED=true

# pdl_rsi — часовой гость раннера счёта rsi_pullback (docs/pdl_rsi/live.md): счёт, токен и расписание общие.
# Боевой режим с 2026-10-27: все тикеры с PF литерала за последние 12 мес выше 1.2 (скилл pdl-rsi-calibrate).
PDL_RSI_TICKERS=SVCB,VTBR,GAZP,MDMG,NVTK,LENT,MRKV,MGNT,X5,AFLT,MOEX,DATA,TGKA,MTSS,ROSN,MRKC,PHOR,MSRS,SPBE,FLOT,MSNG,RENI,BLNG,BSPB,LSNGP,SBER,DELI,ZAYM,RNFT,UNAC,GEMC,SMLT,SBERP,ENPG,MRKU,HNFG,FESH,RBCM,BELU,MTLR,SGZH
PDL_RSI_BUY_PCT=20
PDL_RSI_TRADE_ENABLED=false
PDL_RSI_NOTIFY_ENABLED=true

# FVG: RENI and IVAT are research candidates; trading remains disabled globally.
FVG_IMBALANCE_TICKERS=SNGS,GAZP,SBER,YDEX,ROSN,ALRS,VTBR,AFKS,IRAO,SBERP,POSI,PHOR,GMKN,MAGN,FIXR,X5,MOEX,MTLR,SPBE,VKCO,LSRG,RENI,MGNT,IVAT,AFLT,RTKM,MRKC
FVG_IMBALANCE_BUY_PCT=20
FVG_IMBALANCE_TRADE_ENABLED=true
FVG_IMBALANCE_NOTIFY_ENABLED=true
TELEGRAM_TOPIC_FVG_IMBALANCE=5643

TELEGRAM_GROUP_CHAT_ID=-1004160847192
TELEGRAM_TOPIC_GOLDEN_X=2
TELEGRAM_TOPIC_REVERSION=3
TELEGRAM_TOPIC_NEWS=29
TELEGRAM_TOPIC_RSI_PULLBACK=596
TELEGRAM_TOPIC_PDL_RSI=5163

# drop_bounce: вселенная 1h для будущего live-раннера (ведёт скилл drop-bounce-calibrate)
DROP_BOUNCE_TICKERS_M15=

# pdl_reclaim: вселенная 15m для будущего live-раннера (тикер — только с пакетом в pdlReclaimRegistry)
PDL_RECLAIM_TICKERS_M15=

# Скринер плотностей Мосбиржи. true включает наблюдение за стаканами и отправку алертов.
DENSITY_ENABLED=true
# ID Telegram-чата для алертов о плотностях Мосбиржи.
DENSITY_CHAT_ID=-1004160847192
# ID темы Telegram для алертов о плотностях. 0 отправляет в General.
DENSITY_TOPIC_ID=5809
# Алерты виртуальных сделок идут в General (0) или в указанную тему симуляции.
DENSITY_SIMULATION_TOPIC_ID=0
# Мосбиржа: максимальное расстояние от лучшего bid до плотности для алерта, в тиках включительно.
DENSITY_ALERT_DISTANCE_TICKS=2
# Минимальное время непрерывного наблюдения плотности для подтверждения.
DENSITY_PERSISTENCE=2s
# Минимальный объём плотности для алерта в долях среднего объёма свечи M5.
DENSITY_ALERT_M5_VOLUME_MULTIPLIER=0.5
# Доля среднего дневного оборота для порога плотности. 0.004 = 0.4%, 0 отключает привязку к обороту.
# Действует больший из двух порогов: доля оборота или DENSITY_MIN_RUBLES.
DENSITY_TURNOVER_FRACTION=0.004
# Требовать близость плотности к исторической поддержке и для сигнала, и для покупки.
DENSITY_SUPPORT_ENABLED=false
# Глубина истории завершённых часовых свечей для поиска поддержек, календарные дни.
DENSITY_SUPPORT_LOOKBACK_DAYS=60
# Минимум должен быть ниже минимумов этого числа свечей с КАЖДОЙ стороны.
DENSITY_SUPPORT_PIVOT_BARS=2
# Минимальное число отдельных подтверждённых отскоков в одной зоне поддержки.
DENSITY_SUPPORT_MIN_TOUCHES=2
# Минимальный интервал между учитываемыми подходами к одной зоне поддержки.
DENSITY_SUPPORT_MIN_SEPARATION=3h
# Подтверждение отскока: закрытие после минимума выше него хотя бы на 0.005 = 0.5%.
DENSITY_SUPPORT_BOUNCE_FRACTION=0.005
# Окно подтверждения отскока: следующие 6 завершённых часовых свечей.
DENSITY_SUPPORT_BOUNCE_BARS=6
# Допуск для объединения минимумов в зону поддержки и проверки близости плотности к ней.
# 0.003 = 0.3%. Закрытие ниже центра зоны более чем на этот допуск аннулирует предыдущие подходы.
DENSITY_SUPPORT_TOLERANCE=0.003

# Запускать density-участника автоматически вместе с приложением.
DENSITY_LIVE_ENABLED=true
# false — виртуальная торговля с алертами об исполнениях; true — реальные заявки.
DENSITY_LIVE_TRADE_ENABLED=false
# Тейк-профит: расстояние от входа до стопа умножается на этот коэффициент.
DENSITY_LIVE_RR=5
# Постоянный список тикеров для виртуальной и реальной торговли.
DENSITY_LIVE_TICKERS=T,SBER,GAZP,VTBR
# Допускать дополнительные тикеры к торговле после успешной отправки алерта скринером.
DENSITY_LIVE_FOLLOW_SCREENER=true
# Исторический отступ стопа в тиках под плотностью. Текущий режим использует 0.2% от цены входа.
DENSITY_LIVE_STOP_TICKS=2
# ID темы Telegram для сообщений об исполнениях в симуляции Мосбиржи. 0 отправляет в General.
DENSITY_SIMULATION_TOPIC_ID=3

# true включает скринер и симуляцию Bybit.
BYBIT_DENSITY_ENABLED=true
# Bybit: максимальное расстояние от лучшего bid до плотности для алерта, в тиках включительно.
BYBIT_DENSITY_ALERT_DISTANCE_TICKS=5
# Минимальный объём плотности для алерта в долях среднего объёма свечи M5.
BYBIT_DENSITY_ALERT_M5_VOLUME_MULTIPLIER=0.4
# Каталог для журнала симуляции и очереди уведомлений Bybit.
BYBIT_DENSITY_STATE_DIR=/application/data/state/bybit-density
# ID Telegram-чата для алертов о плотностях Bybit.
BYBIT_DENSITY_SCREENER_CHAT_ID=-1004160847192
# ID темы Telegram для алертов о плотностях Bybit. 0 отправляет в General.
BYBIT_DENSITY_SCREENER_TOPIC_ID=9686
# ID Telegram-чата для отчётов о сделках симуляции Bybit.
BYBIT_DENSITY_SIMULATION_CHAT_ID=-1004160847192
# ID темы Telegram для отчётов о сделках симуляции Bybit. 0 отправляет в General.
BYBIT_DENSITY_SIMULATION_TOPIC_ID=9688
# Множитель расстояния от фактического входа до стопа для расчёта тейк-профита в симуляции Bybit.
BYBIT_DENSITY_REWARD_RISK=3
