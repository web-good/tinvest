APP_PORT=8081
SWAGGER_PORT=8086
APP_ENV=prod
APP_NAME=t-invest
PROFILES='[{"TBank":"Alice","ChatId":30},{"TBank":"Bob","ChatId":40}]'
PORTFOLIO_YTD_START_VALUE=463402

# Reversion live runner
REVERSION_ACCOUNT_ID=2021520905
REVERSION_TICKERS=UGLD,EUTR,NVTK
REVERSION_BUY_PCT=10
REVERSION_TRADE_ENABLED=false
REVERSION_NOTIFY_ENABLED=true

# RSI Pullback live runner (docs/rsi_pullback/live.md).
# Пока RSI_PULLBACK_ACCOUNT_ID пуст, воркер не поднимается — остальное приложение
# (Golden X, новости, оба воркера reversion) работает как обычно. Заполнять после того,
# как заведён отдельный счёт; RSI_PULLBACK_TOKEN приходит из секрета CI, не отсюда.
RSI_PULLBACK_ACCOUNT_ID=2026317489
RSI_PULLBACK_TICKERS=UGLD,T,GAZP,DOMRF,FESH,WUSH,LENT,RENI,NVTK,LSNGP,IVAT,SVAV,SIBN,ELFV,DIAS,BSPB,YDEX,BANEP,ASTR,SNGSP,NKHP,SOFL,TGKA,VSMO,SPBE,MVID,CNRU,AQUA,MAGN,IRKT,X5,SFIN,SVCB,RAGR,MDMG
RSI_PULLBACK_BUY_PCT=20
RSI_PULLBACK_TRADE_ENABLED=true
RSI_PULLBACK_NOTIFY_ENABLED=true
RSI_PULLBACK_SCHEDULE=1,31 6-23 * * *

# RSI Zone на счёте rsi_pullback (docs/rsi_zone/live.md): счёт, токен и расписание общие.
# Боевой режим с 2026-10-05: pullparity 0 расхождений (AFKS, BAZA, DIAS, 24 мес).
# Доля 5% — та, на которой мерилась совместная работа с rsi_pullback (50%).
RSI_ZONE_TICKERS=AFKS,BAZA,DIAS,IVAT,UPRO,MTSS,AFLT,MSNG,BANE,SVAV,TRNFP,SMLT,TATNP,RENI,FIXR,MOEX,TRMK,PHOR,HEAD,VTBR
RSI_ZONE_BUY_PCT=20
RSI_ZONE_TRADE_ENABLED=true
RSI_ZONE_NOTIFY_ENABLED=true

# Буст доли у тикера, отставшего от IMOEX (docs/rsi_pullback/live.md). Выключено.
LAG_BOOST_ENABLED=false
LAG_BOOST_MULT=2
LAG_BOOST_PCT=5
LAG_BOOST_DAYS=5

# gap_fade на счёте rsi_pullback (docs/gap_fade/live.md): счёт, токен и расписание общие.
# Вселенная — из cmd/gapscreen, проверена cmd/gapwf. Боевой режим с 2026-10-05
# после бумажного периода; pullparity 46/46 без расхождений.
GAP_FADE_TICKERS=SBER,T,GAZP,VTBR,LKOH,ROSN,PLZL,NVTK,SMLT,GMKN,YDEX,RUAL,OZON,X5,AFLT,AFKS,MAGN,TATN,MGNT,VKCO,WUSH,NLMK,MTLR,CHMF,MOEX,ALRS,SNGSP,RNFT,SVCB,SFIN,UGLD,SNGS,TRNFP,IRAO,DOMRF,MTSS,SBERP,PHOR,IVAT,POSI,SIBN,ASTR,RAGR,SELG,TATNP
GAP_FADE_BUY_PCT=20
GAP_FADE_TRADE_ENABLED=true
GAP_FADE_NOTIFY_ENABLED=true

# pdl_rsi — часовой гость раннера счёта rsi_pullback (docs/pdl_rsi/live.md): счёт, токен и расписание общие.
# Боевой режим с 2026-10-27: все тикеры с PF литерала за последние 12 мес выше 1.2 (скилл pdl-rsi-calibrate).
PDL_RSI_TICKERS=SVCB,VTBR,GAZP,MDMG,NVTK,LENT,MRKV,MGNT,X5,AFLT,MOEX,DATA,TGKA,MTSS,ROSN,MRKC,PHOR,MSRS,SPBE,FLOT,MSNG,RENI,BLNG
PDL_RSI_BUY_PCT=30
PDL_RSI_TRADE_ENABLED=true
PDL_RSI_NOTIFY_ENABLED=true

TELEGRAM_GROUP_CHAT_ID=-1004160847192
TELEGRAM_TOPIC_GOLDEN_X=2
TELEGRAM_TOPIC_REVERSION=3
TELEGRAM_TOPIC_NEWS=29
TELEGRAM_TOPIC_RSI_PULLBACK=596
TELEGRAM_TOPIC_PDL_RSI=5163

# drop_bounce: вселенная 1h для будущего live-раннера (ведёт скилл drop-bounce-calibrate)
DROP_BOUNCE_TICKERS_M15=

# pdl_reclaim: вселенная 15m для будущего live-раннера (тикер — только с пакетом в pdlReclaimRegistry)
PDL_RECLAIM_TICKERS_M15=
