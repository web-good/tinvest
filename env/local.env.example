APP_PORT=8081
SWAGGER_PORT=8086
APP_ENV=dev
APP_NAME=t-invest
PORTFOLIO_YTD_START_VALUE=
# Telegram forum supergroup (ID вида -100XXXXXXXXXX) и ID тем (message_thread_id)
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_TOPIC_GOLDEN_X=
TELEGRAM_TOPIC_REVERSION=
TELEGRAM_TOPIC_NEWS=
TELEGRAM_TOPIC_RSI_PULLBACK=
# NEWS_FEED_URL можно не задавать: дефолт — https://smart-lab.ru/news/rss/
# NEWS_FEED_URL=

# --- Живой раннер rsi_pullback (docs/rsi_pullback/live.md) ---
# Отдельный счёт и токен: reversion тоже торгует UGLD, и на общем счёте одна стратегия
# видела бы позицию другой как свою. Обе переменные обязательны — без них приложение не
# стартует.
RSI_PULLBACK_ACCOUNT_ID=
RSI_PULLBACK_TOKEN=
# Вселенная раннера. Торговать можно только откалиброванные тикеры; с 2026-08-17 это весь
# реестр — RENI, NVTK и LSNGP заведены решением владельца последними, IVAT добавлен 2026-08-18.
# Доказательная база неодинакова: у DOMRF она слабее прочих (8.8 мес истории, один аптренд), у
# LSNGP в истории нет падающего окна вовсе, у NVTK слепые темы худшие в каталоге, у IVAT истории
# всего 26 мес и 85% результата принятой точки делает одна неделя июля 2026 — см.
# docs/rsi_pullback/live.md §10.
RSI_PULLBACK_TICKERS=UGLD,T,GAZP,DOMRF,FESH,WUSH,LENT,RENI,NVTK,LSNGP,IVAT,SVAV
# Доля полной стоимости счёта (кэш + позиции) на одну сделку, затем ограничение кэшем.
RSI_PULLBACK_BUY_PCT=5
# Выкат: сначала dry-run (TRADE=false, NOTIFY=true) и сверка сигналов с бэктестом,
# только потом торговля.
RSI_PULLBACK_TRADE_ENABLED=false
RSI_PULLBACK_NOTIFY_ENABLED=true
# Каждые полчаса, все семь дней недели: позиция едет через выходные. Минута :01/:31 —
# запас на приход закрывшегося бара из API.
RSI_PULLBACK_SCHEDULE=1,31 6-23 * * *
