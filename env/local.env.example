APP_PORT=8081
SWAGGER_PORT=8086
APP_ENV=dev
APP_NAME=t-invest
PORTFOLIO_YTD_START_VALUE=
# Telegram forum supergroup (ID вида -100XXXXXXXXXX) и ID тем (message_thread_id)
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_TOPIC_GOLDEN_X=
TELEGRAM_TOPIC_REVERSION=
TELEGRAM_TOPIC_NEWS=
TELEGRAM_TOPIC_RSI_PULLBACK=
TELEGRAM_TOPIC_RSI_ZONE=
TELEGRAM_TOPIC_GAP_FADE=
# NEWS_FEED_URL можно не задавать: дефолт — https://smart-lab.ru/news/rss/
# NEWS_FEED_URL=

# --- Живой раннер rsi_pullback (docs/rsi_pullback/live.md) ---
# Отдельный счёт и токен: reversion тоже торгует UGLD, и на общем счёте одна стратегия
# видела бы позицию другой как свою. На этом счёте торгует и rsi_zone (блок ниже). Обе
# переменные обязательны — без них приложение не стартует.
RSI_PULLBACK_ACCOUNT_ID=
RSI_PULLBACK_TOKEN=
# Вселенная раннера. Торговать можно только откалиброванные тикеры; с 2026-08-17 это весь
# реестр — RENI, NVTK и LSNGP заведены решением владельца последними, IVAT добавлен 2026-08-18.
# Доказательная база неодинакова: у DOMRF она слабее прочих (8.8 мес истории, один аптренд), у
# LSNGP в истории нет падающего окна вовсе, у NVTK слепые темы худшие в каталоге, у IVAT истории
# всего 26 мес и 85% результата принятой точки делает одна неделя июля 2026, у IRKT медиана оборота
# за последние шесть месяцев 39.5 млн ₽ — НИЖЕ гейта вселенной 50 млн ₽, а реальный круг издержек
# 0.206% вдвое выше модельного 0.1% — см. docs/rsi_pullback/live.md §8.
RSI_PULLBACK_TICKERS=UGLD,T,GAZP,DOMRF,FESH,WUSH,LENT,RENI,NVTK,LSNGP,IVAT,SVAV,SIBN,ELFV,DIAS,BSPB,YDEX,BANEP,ASTR,SNGSP,NKHP,SOFL,TGKA,VSMO,SPBE,MVID,CNRU,AQUA,MAGN,IRKT,X5,SFIN,SVCB,RAGR,MDMG
# Доля полной стоимости счёта (кэш + позиции) на одну сделку, затем ограничение кэшем.
RSI_PULLBACK_BUY_PCT=5
# Выкат: сначала dry-run (TRADE=false, NOTIFY=true) и сверка сигналов с бэктестом,
# только потом торговля.
RSI_PULLBACK_TRADE_ENABLED=false
RSI_PULLBACK_NOTIFY_ENABLED=true
# Каждые полчаса, все семь дней недели: позиция едет через выходные. Минута :01/:31 —
# запас на приход закрывшегося бара из API.
RSI_PULLBACK_SCHEDULE=1,31 6-23 * * *

# RSI Zone на счёте rsi_pullback (docs/rsi_zone/live.md): счёт, токен и расписание общие.
# Выкат — сначала бумажный режим при боевом rsi_pullback: бумажные входы zone приходят
# только уведомлениями и тикер не занимают.
RSI_ZONE_TICKERS=AFKS,BAZA,DIAS,IVAT,UPRO,MTSS,AFLT,MSNG,BANE,SVAV,TRNFP,SMLT,TATNP,RENI,FIXR,MOEX,TRMK
RSI_ZONE_BUY_PCT=5
RSI_ZONE_TRADE_ENABLED=false
RSI_ZONE_NOTIFY_ENABLED=true

# gap_fade на счёте rsi_pullback (docs/gap_fade/live.md): счёт, токен и расписание общие.
# Вселенная — из cmd/gapscreen, проверена cmd/gapwf. Выкат — бумажный режим при боевом
# rsi_pullback: входы приходят только уведомлениями и тикер не занимают.
GAP_FADE_TICKERS=
GAP_FADE_BUY_PCT=5
GAP_FADE_TRADE_ENABLED=false
GAP_FADE_NOTIFY_ENABLED=true
